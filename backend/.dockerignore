# Docker build-context exclusions. Context root is backend/ — Docker reads
# .dockerignore only from the context root, so this file must sit beside the
# Dockerfile and the build must be run as `docker build ./backend`.
#
# Patterns without a leading **/ are anchored at the context root.

# ── Secrets ───────────────────────────────────────────────────────────────────
# backend/.env holds a live GROQ_API_KEY (gitignored). Baking it into a layer
# would publish it to anyone who pulls the image, and deleting it in a later
# layer would not remove it from history. Configuration arrives at runtime only.
.env
.env.*

# ── Python bytecode and tool caches ───────────────────────────────────────────
**/__pycache__
**/*.py[cod]
**/.pytest_cache
.hypothesis
*.egg-info

# ── Local virtualenvs ─────────────────────────────────────────────────────────
# Hundreds of MB of host-specific (Windows) binaries that would also shadow the
# image's own /opt/venv.
venv
.venv

# ── Test and developer tooling ────────────────────────────────────────────────
# None of this is reachable from the serving path
# (main -> graph -> llm/config/budget/observability/json_utils/ideas/domain).
tests
eval
scripts
etl
requirements-dev.txt

# ── Data ──────────────────────────────────────────────────────────────────────
# Raw USDA FDC bulk CSVs (~17 MB, gitignored) consumed only by the ETL, and an
# unused local vector store.
#
# NOTE: domain/data/ingredients.json is deliberately NOT excluded — `data`
# anchors at the context root, so it does not match domain/data. That file is
# the governed ingredient library; without it every formulation fails and
# /health reports ingredient_library unavailable.
data
chroma_db
# Belt and braces on the note above: re-include the governed library explicitly
# so no future edit (or a reader who assumes per-component matching) can drop it.
!domain/data

# ── Deploy descriptors for the non-container path ─────────────────────────────
Procfile
runtime.txt
.python-version

# ── Docker's own files ────────────────────────────────────────────────────────
Dockerfile
.dockerignore

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
*.log
*.swp
