# ── LLM Provider ─────────────────────────────────────────────────────────────
# Primary provider: groq (default), openai, or anthropic. openai/anthropic also
# require their SDK (langchain-openai / langchain-anthropic) and API key.
LLM_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. llama-3.3-70b-versatile is the default.
GROQ_MODEL=openai/gpt-oss-120b

# Model id for a non-groq primary provider (required if LLM_PROVIDER != groq).
# LLM_MODEL=gpt-4o-mini

# Fallback chain: on a primary failure, requests degrade to this model.
ENABLE_LLM_FALLBACK=true
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-20b

# ── Abuse controls ────────────────────────────────────────────────────────────
# CORS allowlist (comma-separated). Do NOT use "*" in production.
ALLOWED_ORIGINS=http://localhost:5173,https://formula-forge-chi.vercel.app
# Per-IP request rate limit for /api/chat.
CHAT_RATE_LIMIT=30/minute
# Daily token budgets (reserve-up-front, in-process for single-instance Phase A).
GLOBAL_DAILY_TOKENS=2000000
SESSION_DAILY_TOKENS=50000

# ── Service identity ──────────────────────────────────────────────────────────
# Reported by the /health readiness probe so a running container can be matched
# to the build it came from. Stamp a git SHA here at image build time.
APP_VERSION=1.0.0

# ── Observability (optional) ──────────────────────────────────────────────────
# LangSmith tracing. Off by default: with tracing on and no valid key, the
# LangSmith client retries every run in the background and floods the console
# with 403s — including on the first `pytest` run of a fresh clone. Turn it on
# only once LANGCHAIN_API_KEY holds a real key (free at https://smith.langchain.com).
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=formula-forge
