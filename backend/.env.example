# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use. Currently only "groq" is supported.
LLM_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. llama-3.3-70b-versatile is the default.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Observability (optional) ──────────────────────────────────────────────────
# LangSmith tracing — get a free key at https://smith.langchain.com
# When set, every LangGraph run is traced automatically. Leave blank to disable.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=formula-forge
